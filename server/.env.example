# Kora Server — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/kora_messenger

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Email (for OTP & reset — use Nodemailer config)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# OAuth (configure when available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Payments (configure when available)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloud Storage (configure when available)
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_KEY=
CLOUD_STORAGE_SECRET=

# Translation API (configure when available)
TRANSLATION_API_KEY=
TRANSLATION_API_URL=

# App URLs
CLIENT_URL=http://localhost:3000
